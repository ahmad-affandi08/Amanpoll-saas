APP_NAME=Amanpoll
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.amanpoll.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_Amanpoll
DB_USERNAME=u123456789_Amanpoll
DB_PASSWORD=GANTI_PASSWORD_KUAT

# Host (RUNBOOK-DEPLOYMENT 2). Satu instalasi melayani ketiganya.
AMANPOLL_DOMAIN_DASHBOARD=app.amanpoll.id
AMANPOLL_DOMAIN_PUBLIK=amanpoll.id
AMANPOLL_DOMAIN_PARTNER=partner.amanpoll.id
AMANPOLL_DOMAIN_SKEMA=https

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Domain induk dengan titik di depan, supaya sesi berlaku lintas subdomain.
SESSION_DOMAIN=.amanpoll.id
# Wajib true di produksi; boot ditolak bila tidak (PenjagaKonfigurasiProduksi).
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Antrean database dikerjakan dua pekerja cron (routes/console.php, FASE 45):
# high/default dengan --timeout=45, low (ekspor laporan) dengan --timeout=310.
# retry_after tiap koneksi harus melampaui --timeout pekerjanya.
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=AntrianPekerjaan
DB_QUEUE_RETRY_AFTER=90
DB_QUEUE_PANJANG_RETRY_AFTER=420
DB_JOB_BATCHES_TABLE=KelompokAntrianPekerjaan
DB_FAILED_JOBS_TABLE=PekerjaanGagal

# Penyedia email dipilih di konsol platform (FASE 44), bukan di sini. Tanpa
# penyedia aktif, email diteruskan ke mailer cadangan di bawah (bawaan `log`:
# tercatat di log, tidak terkirim).
MAIL_MAILER=amanpoll
AMANPOLL_EMAIL_MAILER_CADANGAN=log
MAIL_FROM_ADDRESS=noreply@amanpoll.id
MAIL_FROM_NAME=Amanpoll
# Hanya dipakai bila AMANPOLL_EMAIL_MAILER_CADANGAN=smtp:
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=smtps

AMANPOLL_HEADER_ORGANISASI=X-Organisasi-Id
AMANPOLL_AUDIT_AKTIF=true
AMANPOLL_MATA_UANG=IDR
# Zona bawaan organisasi yang belum menyetel ZonaWaktu, dan zona kalender vendor
# (pemasaran, penagihan). Aplikasi dan basis data selalu berjalan dalam UTC;
# config/app.php mengunci 'UTC', jadi APP_TIMEZONE sengaja tidak dipakai.
AMANPOLL_ZONA_WAKTU=Asia/Jakarta
AMANPOLL_QUEUE_CRON=true

# Cadangan (RUNBOOK-PEMULIHAN). Dibuat di folder lokal, lalu disalin ke disk luar
# dan diverifikasi. Kosongkan AMANPOLL_CADANGAN_DISK_LUAR hanya bila memang tidak
# ada object storage: cadangan lalu tinggal di server yang sama dengan datanya dan
# setiap malam tercatat peringatan.
AMANPOLL_CADANGAN_DISK=local
AMANPOLL_CADANGAN_FOLDER=cadangan
AMANPOLL_CADANGAN_DISK_LUAR=cadangan_luar
AMANPOLL_CADANGAN_FOLDER_LUAR=cadangan
AMANPOLL_CADANGAN_RETENSI_HARI=14
AMANPOLL_CADANGAN_RETENSI_LOKAL_HARI=2
AMANPOLL_CADANGAN_RETENSI_LUAR_HARI=30
AMANPOLL_CADANGAN_BERKAS_PENUH_TIAP_HARI=7
AMANPOLL_CADANGAN_VERIFIKASI_CHECKSUM=true
# Isi jalur lengkap bila biner tidak ada di PATH shared hosting.
AMANPOLL_CADANGAN_MYSQLDUMP=mysqldump
AMANPOLL_CADANGAN_MYSQL=mysql

# Disk `cadangan_luar` (config/filesystems.php), kompatibel S3. Cloudflare R2:
# endpoint https://<ID-AKUN>.r2.cloudflarestorage.com, region auto, path-style.
# Pakai token yang hanya berhak atas bucket cadangan ini.
AMANPOLL_CADANGAN_LUAR_KEY=
AMANPOLL_CADANGAN_LUAR_SECRET=
AMANPOLL_CADANGAN_LUAR_BUCKET=
AMANPOLL_CADANGAN_LUAR_ENDPOINT=
AMANPOLL_CADANGAN_LUAR_REGION=auto
AMANPOLL_CADANGAN_LUAR_PATH_STYLE=true

# Penjaga panggilan keluar (webhook, integrasi, server WhatsApp): hanya host publik lewat https.
AMANPOLL_HTTP_KELUAR_IZINKAN_HTTP=false
# Port selain 80/443 yang boleh dituju, dipisah koma (mis. 3000 bila memakai WAHA self-hosted).
AMANPOLL_HTTP_KELUAR_PORT_TAMBAHAN=
