APP_NAME=Amanpoll
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Amanpoll
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Domain induk (produksi: .amanpoll.id) supaya sesi dan cookie pengunjung bertahan
# saat berpindah dari host publik ke host dashboard (MARKETING.md 1.1).
SESSION_DOMAIN=null
# Wajib true di produksi; boot akan ditolak bila tidak. Dibiarkan kosong di
# lokal supaya http://amanpoll.test tetap dapat dipakai.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Amanpoll shared hosting: queue diproses via Laravel Scheduler + cron, bukan daemon/Horizon.
# Dua pekerja (routes/console.php): high/default --timeout=45 pada koneksi `database`,
# low (ekspor laporan) --timeout=310 pada koneksi `database-panjang`. retry_after
# tiap koneksi harus melampaui --timeout pekerjanya, atau job dikerjakan dobel.
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_TABLE=AntrianPekerjaan
DB_QUEUE_RETRY_AFTER=90
DB_QUEUE_PANJANG_RETRY_AFTER=420
DB_FAILED_JOBS_TABLE=PekerjaanGagal
DB_JOB_BATCHES_TABLE=KelompokAntrianPekerjaan
SESSION_TABLE=SesiAplikasi
CACHE_TABLE=CacheAplikasi
CACHE_LOCK_TABLE=KunciCacheAplikasi

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=amanpoll
# Tanpa penyedia email aktif di konsol platform, email diteruskan ke mailer ini.
AMANPOLL_EMAIL_MAILER_CADANGAN=log
# MAIL_SCHEME s.d. MAIL_PASSWORD hanya dipakai bila AMANPOLL_EMAIL_MAILER_CADANGAN=smtp.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage opsional. Default Amanpoll tetap local/private (lihat FILESYSTEM_DISK).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Host (PRD 5.4, MARKETING.md 1). Situs publik baru hidup setelah
# AMANPOLL_DOMAIN_PUBLIK diisi; sebelum itu root tetap milik dashboard.
# Lokal: amanpoll.test / dashboard.amanpoll.test
# Produksi: amanpoll.id / app.amanpoll.id / partner.amanpoll.id
AMANPOLL_DOMAIN_PUBLIK=
AMANPOLL_DOMAIN_DASHBOARD=localhost
AMANPOLL_DOMAIN_PARTNER=
AMANPOLL_DOMAIN_KANONIK_WWW=false
AMANPOLL_DOMAIN_SKEMA=https

# Konfigurasi khusus Amanpoll (lihat config/amanpoll.php).
AMANPOLL_HEADER_ORGANISASI=X-Organisasi-Id
AMANPOLL_AUDIT_AKTIF=true
AMANPOLL_MATA_UANG=IDR
# Zona bawaan organisasi yang belum menyetel ZonaWaktu, dan zona kalender vendor
# (pemasaran, penagihan). Aplikasi dan basis data selalu berjalan dalam UTC;
# config/app.php mengunci 'UTC', jadi APP_TIMEZONE sengaja tidak dipakai.
AMANPOLL_ZONA_WAKTU=Asia/Jakarta
AMANPOLL_QUEUE_CRON=true

# Cadangan (FASE 25.04, FASE 45). Disk kerja harus lokal; salinan luar server ke
# disk `cadangan_luar` (S3/Cloudflare R2) aktif bila AMANPOLL_CADANGAN_DISK_LUAR diisi.
AMANPOLL_CADANGAN_DISK=local
AMANPOLL_CADANGAN_FOLDER=cadangan
AMANPOLL_CADANGAN_DISK_LUAR=
AMANPOLL_CADANGAN_FOLDER_LUAR=cadangan
AMANPOLL_CADANGAN_RETENSI_HARI=14
AMANPOLL_CADANGAN_RETENSI_LOKAL_HARI=2
AMANPOLL_CADANGAN_RETENSI_LUAR_HARI=30
AMANPOLL_CADANGAN_BERKAS_PENUH_TIAP_HARI=7
AMANPOLL_CADANGAN_VERIFIKASI_CHECKSUM=true
AMANPOLL_CADANGAN_LUAR_KEY=
AMANPOLL_CADANGAN_LUAR_SECRET=
AMANPOLL_CADANGAN_LUAR_BUCKET=
AMANPOLL_CADANGAN_LUAR_ENDPOINT=
AMANPOLL_CADANGAN_LUAR_REGION=auto
AMANPOLL_CADANGAN_LUAR_PATH_STYLE=true
# Isi jalur lengkap bila biner tidak ada di PATH shared hosting.
AMANPOLL_CADANGAN_MYSQLDUMP=mysqldump
AMANPOLL_CADANGAN_MYSQL=mysql

# Kata sandi akun contoh yang dibuat DemoAwalSeeder. Hanya berlaku di luar
# produksi; di produksi seeder itu menolak berjalan.
AMANPOLL_DEMO_KATA_SANDI=password
# false = data demo tanpa riwayat transaksi setahun (seeder jauh lebih cepat).
# AMANPOLL_DEMO_RIWAYAT=true

# Penjaga panggilan keluar (webhook, integrasi, server WhatsApp): hanya host publik.
# http polos hanya diizinkan di local/testing; port selain 80/443 harus disebut di sini (mis. 3000 untuk WAHA).
# AMANPOLL_HTTP_KELUAR_IZINKAN_HTTP=true
# AMANPOLL_HTTP_KELUAR_PORT_TAMBAHAN=3000
