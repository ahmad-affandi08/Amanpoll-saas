APP_NAME=Amanpoll
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Amanpoll
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Domain induk (mis. .amanpoll.com) supaya sesi dan cookie pengunjung bertahan
# saat berpindah dari host publik ke host dashboard (MARKETING.md 1.1).
SESSION_DOMAIN=null
# Wajib true di produksi; boot akan ditolak bila tidak. Dibiarkan kosong di
# lokal supaya http://amanpoll.test tetap dapat dipakai.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Amanpoll shared hosting: queue diproses via Laravel Scheduler + cron, bukan daemon/Horizon.
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_TABLE=AntrianPekerjaan
DB_QUEUE_RETRY_AFTER=90
DB_FAILED_JOBS_TABLE=PekerjaanGagal
DB_JOB_BATCHES_TABLE=KelompokAntrianPekerjaan
SESSION_TABLE=SesiAplikasi
CACHE_TABLE=CacheAplikasi
CACHE_LOCK_TABLE=KunciCacheAplikasi

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage opsional. Default Amanpoll tetap local/private (lihat FILESYSTEM_DISK).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Host (PRD 5.4, MARKETING.md 1). Situs publik baru hidup setelah
# AMANPOLL_DOMAIN_PUBLIK diisi; sebelum itu root tetap milik dashboard.
# Lokal: amanpoll.test / dashboard.amanpoll.test
# Produksi: amanpoll.com / dashboard.amanpoll.com / partner.amanpoll.com
AMANPOLL_DOMAIN_PUBLIK=
AMANPOLL_DOMAIN_DASHBOARD=localhost
AMANPOLL_DOMAIN_PARTNER=
AMANPOLL_DOMAIN_KANONIK_WWW=false
AMANPOLL_DOMAIN_SKEMA=https

# Konfigurasi khusus Amanpoll (lihat config/amanpoll.php).
AMANPOLL_HEADER_ORGANISASI=X-Organisasi-Id
AMANPOLL_AUDIT_AKTIF=true
AMANPOLL_MATA_UANG=IDR
AMANPOLL_ZONA_WAKTU=Asia/Jakarta
AMANPOLL_QUEUE_CRON=true

# Cadangan (FASE 25.04)
AMANPOLL_CADANGAN_DISK=local
AMANPOLL_CADANGAN_FOLDER=cadangan
AMANPOLL_CADANGAN_RETENSI_HARI=14
# Isi jalur lengkap bila biner tidak ada di PATH shared hosting.
AMANPOLL_CADANGAN_MYSQLDUMP=mysqldump
AMANPOLL_CADANGAN_MYSQL=mysql

# Kata sandi akun contoh yang dibuat DemoAwalSeeder. Hanya berlaku di luar
# produksi; di produksi seeder itu menolak berjalan.
AMANPOLL_DEMO_KATA_SANDI=password
